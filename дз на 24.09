import os

collection = [] 
is_running = True


def show_message(message: str) -> None:
    print(f"\n[Уведомление]: {message}\n")

def show_collection(task_collection: list) -> None:
    print("=" * 45)
    if not task_collection:
        print("Список задач пуст.")
    else:
        for i, task in enumerate(task_collection, start=1):
            print(f"{i}. {task}")
    print("=" * 45)

def show_menu() -> None:
    print("1 - Показать задачи \n"
          "2 - Добавить задачу \n"
          "3 - Редактировать задачи \n"
          "4 - Удаление задачи \n"
          "5 - Выход")

def check_confirm(select_task: str, task_list: list) -> bool:
    if select_task.isdigit():
        index = int(select_task)
        if 1 <= index <= len(task_list):
            return True
        else:
            show_message(f"Задачи с номером {select_task} нет в списке!")
            return False
    else:
        show_message("Введите именно номер задачи!")
        return False

def save_tasks(file_name: str, task_collection: list) -> None:
    with open(file_name, 'w', encoding='utf-8') as file:
        for task in task_collection:
            file.write(task + "\n")

def delete_tasks(task_collection: list) -> bool:
    delete_task = input("Введите номер задачи для удаления: ")
    if check_confirm(delete_task, task_collection):
        removed = task_collection.pop(int(delete_task) - 1)
        show_message(f"Задача '{removed}' успешно удалена!")
        return True
    return False

def edit_task(task_collection: list) -> bool:
    task_num = input("Введите номер задачи для редактирования: ")
    if check_confirm(task_num, task_collection):
        new_name = input("Новое имя задачи: ").strip()
        if new_name:
            task_collection[int(task_num) - 1] = new_name
            show_message(f"Задача №{task_num} успешно изменена!")
            return True
        else:
            show_message("Название задачи не может быть пустым!")
    return False

def add_task(task_collection: list) -> bool:
    task_name = input("Введите имя задачи для добавления: ").strip()
    if task_name:
        task_collection.append(task_name)
        show_message(f"Задача '{task_name}' успешно добавлена!")
        return True
    else:
        show_message("Название задачи не может быть пустым!")
        return False

def main():
    global is_running
    name_file = 'saves.txt'
    if os.path.exists(name_file):
        with open(name_file, 'r', encoding='utf-8') as file:
            task_collection = [line.strip() for line in file if line.strip()]
    else:
        task_collection = []

    while is_running:
        show_menu()
        choice_user = input('Введите ваш выбор: ').strip()

        match choice_user:
            case "1":
                show_collection(task_collection)
                input("Нажмите ENTER для продолжения...")

            case "2":
                if add_task(task_collection):
                    save_tasks(name_file, task_collection)

            case "3":
                show_collection(task_collection)
                if edit_task(task_collection):
                    save_tasks(name_file, task_collection)

            case "4":
                show_collection(task_collection)
                if delete_tasks(task_collection):
                    save_tasks(name_file, task_collection)

            case "5":
                is_running = False
                print("До свидания!")

            case _:
                show_message("Такого пункта меню нет!")


if __name__ == '__main__':
    main()
